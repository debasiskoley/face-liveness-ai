# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# API_BASE_URL: Face attendance backend used by Retrofit. Must end with "/".
# 10.0.2.2 reaches the host machine from the Android emulator; use the host's LAN IP for a physical device.
API_BASE_URL=http://10.0.2.2:8080/
